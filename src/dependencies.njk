---
layout: page
title: Dependencies
description: What the Private Landlord workstream needs from other teams.
---
<h2 class="govuk-heading-l">Platform and other teams</h2>
{% if dependencies | length %}
<table class="govuk-table"><thead class="govuk-table__head"><tr class="govuk-table__row">
<th scope="col" class="govuk-table__header">Team</th><th scope="col" class="govuk-table__header">What we need</th>
<th scope="col" class="govuk-table__header">Needed by</th><th scope="col" class="govuk-table__header">Status</th>
<th scope="col" class="govuk-table__header">RAG</th></tr></thead>
<tbody class="govuk-table__body">
{% for d in dependencies | sort(false, false, "id") %}<tr class="govuk-table__row">
<td class="govuk-table__cell">{{ d.team }}</td>
<td class="govuk-table__cell">{{ d.need }}{% if d.why %}<br><span class="govuk-body-s">{{ d.why }}</span>{% endif %}{% if d.jira %}<br><a class="govuk-link" href="https://hmcts.atlassian.net/browse/{{ d.jira }}">{{ d.jira }}</a>{% endif %}</td>
<td class="govuk-table__cell">{{ d.needed_by | date if d.needed_by else "" }}</td>
<td class="govuk-table__cell">{{ d.status | replace("-", " ") | capitalize }}</td>
<td class="govuk-table__cell">{{ d.rag | ragTag }}</td></tr>
{% endfor %}</tbody></table>
{% else %}
<p class="govuk-body">No dependencies have been recorded yet.</p>
{% endif %}

<h2 class="govuk-heading-l">Links from our epics to other Jira projects</h2>
{% set links = roadmap.latest.dependencies if roadmap.latest else [] %}
{% if links | length %}
<table class="govuk-table"><thead class="govuk-table__head"><tr class="govuk-table__row">
<th scope="col" class="govuk-table__header">Our epic</th><th scope="col" class="govuk-table__header">Relationship</th>
<th scope="col" class="govuk-table__header">Other team's issue</th><th scope="col" class="govuk-table__header">Its status</th></tr></thead>
<tbody class="govuk-table__body">
{% for l in links %}<tr class="govuk-table__row">
<td class="govuk-table__cell">{{ l.epic }}</td><td class="govuk-table__cell">{{ l.relation }}</td>
<td class="govuk-table__cell"><a class="govuk-link" href="{{ l.linkedUrl }}">{{ l.linked }}</a></td>
<td class="govuk-table__cell">{{ l.linkedStatus | statusTag(l.linkedCategory) }}</td></tr>
{% endfor %}</tbody></table>
{% else %}
<p class="govuk-body">None of our epics are linked to issues in other Jira projects yet.</p>
{% endif %}
{% include "data-notice.njk" %}
