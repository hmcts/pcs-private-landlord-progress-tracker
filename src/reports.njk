{% macro links(items) %}
{% if items | length %}
<ul class="govuk-list govuk-list--bullet">
{% for r in items %}<li><a class="govuk-link" href="{{ r.href or r.url or (r.page | confluenceUrl) }}">{{ r.title }}</a>{% if r.href %} (<a class="govuk-link" href="{{ r.url }}">on Confluence</a>){% endif %}{% if r.description %}<br><span class="govuk-body-s">{{ r.description }}</span>{% endif %}</li>
{% endfor %}</ul>
{% else %}
<p class="govuk-body">None yet.</p>
{% endif %}
{% endmacro %}

