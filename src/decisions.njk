---
layout: page
title: Decisions log
description: Product and design decisions about how the private landlord claim journey should behave.
---
{% set groups = [
  ["eligibility", "Eligibility"], ["about-you", "About you"], ["defendants", "Defendants"],
  ["tenancy-and-grounds", "Tenancy and grounds"], ["notice", "Notice"], ["rent-arrears", "Rent arrears"],
  ["check-and-submit", "Check and submit"], ["pay", "Pay"], ["journey", "Across the journey"], ["other", "Other pages"]
] %}
{% set outcomes = {
  "fix": ["Fix", "govuk-tag--blue"], "keep": ["Keep as is", "govuk-tag--grey"], "open-question": ["Open question", "govuk-tag--yellow"]
} %}
{% macro decisionTable(items) %}
<table class="govuk-table"><thead class="govuk-table__head"><tr class="govuk-table__row">
<th scope="col" class="govuk-table__header">ID</th><th scope="col" class="govuk-table__header">Decision</th>
<th scope="col" class="govuk-table__header">Outcome</th><th scope="col" class="govuk-table__header">Date</th></tr></thead>
<tbody class="govuk-table__body">
{% for i in items | sort(false, false, "id") %}{% set o = outcomes[i.outcome] %}<tr class="govuk-table__row">
<td class="govuk-table__cell app-nowrap">{{ i.id }}</td>
<td class="govuk-table__cell"><strong>{{ i.title }}</strong><br>{{ i.decision }}</td>
<td class="govuk-table__cell"><strong class="govuk-tag {{ o[1] }}">{{ o[0] }}</strong></td>
<td class="govuk-table__cell app-nowrap">{{ i.date | date }}</td></tr>
{% endfor %}</tbody></table>
{% endmacro %}
{% if not decisions | length %}
<p class="govuk-body">No decisions have been recorded yet.</p>
{% endif %}
{% set open = decisions | where("outcome", "open-question") %}
<h2 class="govuk-heading-l">Open decisions</h2>
{% if open | length %}
{{ decisionTable(open) }}
{% else %}
<p class="govuk-body">There are no open decisions.</p>
{% endif %}
{% for g in groups %}
{% set items = decisions | where("area", g[0]) | whereNot("outcome", "open-question") %}
{% if items | length %}
<h2 class="govuk-heading-l">{{ g[1] }}</h2>
{{ decisionTable(items) }}
{% endif %}
{% endfor %}
<p class="govuk-body-s">{{ decisions | length }} decisions in total. To add or change one, open a pull request that edits <code>src/_data/decisions.yaml</code>.</p>
