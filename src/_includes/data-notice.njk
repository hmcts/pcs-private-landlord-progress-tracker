{% if not roadmap.latest %}
<div class="govuk-warning-text"><span class="govuk-warning-text__icon" aria-hidden="true">!</span>
<strong class="govuk-warning-text__text"><span class="govuk-visually-hidden">Warning</span>No roadmap data has been fetched from Jira yet.</strong></div>
{% elif roadmap.stale %}
<div class="govuk-warning-text"><span class="govuk-warning-text__icon" aria-hidden="true">!</span>
<strong class="govuk-warning-text__text"><span class="govuk-visually-hidden">Warning</span>This data may be out of date. It was last read from Jira on {{ roadmap.latest.date | date }}.</strong></div>
{% else %}
<p class="govuk-body-s">Read from Jira on {{ roadmap.latest.date | date }} at {{ roadmap.latest.generatedAt.slice(11, 16) }} UTC.</p>
{% endif %}
